@model List<Kawai.Domain.DTOs.ShippingInstructionReportDto>
@{
    var first = Model != null && Model.Count > 0 ? Model[0] : null;
}

<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Surat Jalan</title>

    <style>
        @@page {
            size: A4 portrait;
            margin: 8mm;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 10px;
            margin: 0;
            padding: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td,
        th {
            padding: 3px 5px;
        }

        .no-border {
            border: none !important;
        }

        .center {
            text-align: center;
        }

        .right {
            text-align: right;
        }

        .bold {
            font-weight: bold;
        }

        .header td {
            border: none;
            padding: 1px;
        }

        .title {
            font-size: 16px;
            font-weight: bold;
            text-align: center;
        }

        .small {
            font-size: 9px;
        }

        .sign td {
            height: 70px;
            text-align: center;
            vertical-align: bottom;
        }

        /* Helper border style untuk tabel barang */
        .table-items,
        .table-items th,
        .table-items td {
            border: 1px solid black;
        }
    </style>
</head>

<body>
    <!-- HEADER ATAS -->
    <table class="header mt-6">
        <tr class="center">
            <td class="bold">@first?.CompanyName</td>
        </tr>
        <tr class="center">
            <td>
                @first?.CompanyAddress
            </td>
        </tr>
        <tr class="center">
            <td style="border-bottom: 1px solid black;">
                @first?.Phone
            </td>
        </tr>
        <tr>
            <td></td>
        </tr>
    </table>

    <br />

    <!-- INFORMASI -->
    <table>
        <tr>
            <td style="width:15%">No</td>
            <td style="width:1%">:</td>
            <td style="width: 34%">@first?.SJNo</td>

            <td class="no-border"></td>

            <td style="width:15%">Delivery To</td>
            <td style="width:1%">:</td>
            <td rowspan="3"
                style="width: 34%; white-space: nowrap; vertical-align: top">
                @first?.Delivery <br />
                @first?.DeliveryAddress <br />
                @first?.DeliveryCity
            </td>
        </tr>
        <tr>
            <td>Cust PO No</td>
            <td>:</td>
            <td>@first?.CustPONo</td>

            <td class="no-border"></td>

            <td></td>
            <td></td>
            <td></td>
        </tr>

        <tr>
            <td>BC Type</td>
            <td>:</td>
            <td>@first?.BCType</td>

            <td class="no-border"></td>

            <td></td>
            <td></td>
            <td></td>
        </tr>

        <tr>
            <td>BC Number</td>
            <td>:</td>
            <td>@first?.BCNumber</td>

            <td class="no-border small"></td>

            <td></td>
            <td></td>
            <td></td>
        </tr>

        <tr>
            <td>QTY</td>
            <td>:</td>
            <td>@first?.Qty</td>

            <td class="no-border"></td>

            <td></td>
            <td></td>
            <td></td>
        </tr>

        <tr>
            <td>Invoice No</td>
            <td>:</td>
            <td></td>

            <td class="no-border"></td>

            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td>No. Pol</td>
            <td>:</td>
            <td></td>

            <td class="no-border"></td>

            <td>No. Container</td>
            <td>:</td>
            <td>
                <div style="display: flex">
                    <div style="width: 100px">&nbsp;</div>
                    <label for="">No. Seal : </label>
                </div>
            </td>
        </tr>
    </table>

    <br />

    <!-- TABLE BARANG -->
    <table class="table-items">
        <thead>
            <tr class="center bold">
                <th style="width: 5%">No</th>
                <th>Part Number & Description</th>
                <th style="width: 15%">Serial From</th>
                <th style="width: 15%">Serial To</th>
                <th style="width: 15%">QTY Pengiriman</th>
                <th style="width: 10%">Satuan</th>
                <th style="width: 20%">Keterangan</th>
            </tr>
        </thead>
        <tbody>
            @{
                int no = 1;
            }

            @foreach (var item in Model.OrderBy(p => p.ItemCode))
            {
                <tr>
                    <td class="center">@no</td>
                    <td style="white-space: nowrap">@item.ItemCode @item.ItemName</td>
                    <td class="center">@item.SerialNoFrom</td>
                    <td class="center">@item.SerialNoTo</td>
                    <td class="right">@item.QtyNG.ToString("N2")</td>
                    <td class="center">@item.UnitCls</td>
                    <td>@item.Remarks</td>
                </tr>
                no++;
            }

            <tr class="bold">
                <td colspan="4" class="center">Total Qty</td>
                <td class="right">@Model.Sum(y => y.QtyNG).ToString("N2")</td>
                <td colspan="2" style="border: 1px solid black;"></td>
            </tr>
        </tbody>
    </table>

    <br />

    <!-- NOTE -->
    <table>
        <tr>
            <td class="no-border small">
                * Please return this original letter to <span>@first?.CompanyName</span>
            </td>
        </tr>
    </table>

    <br />
    <!-- SIGN -->
    <div style="display:flex; width: 100%;">

        <div style="width: 80%">
            <table class="table-items">
                <thead>
                    <tr class="center bold">
                        <th style="width: 20%">Warehouse</th>
                        <th style="width: 20%"></th>
                        <th style="width: 20%">Security</th>
                        <th style="width: 20%">Pembawa</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="height: 5em"></td>
                        <td style="height: 5em"></td>
                        <td style="height: 5em"></td>
                        <td style="height: 5em"></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div style="width: 20%; margin-left: 10em;">
            <table class="table-items">
                <thead>
                    <tr class="center bold">
                        <th>Penerima</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="height: 5em"></td>
                    </tr>
                </tbody>
            </table>

        </div>
    </div>
</body>
</html>
